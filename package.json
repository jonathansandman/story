{
  "name": "trellis",
  "private": true,
  "version": "0.1.0",
  "description": "Local-first planning tool for long-form, character-driven fiction. Characters \u2192 Stories \u2192 Chapters \u2192 Beats, exported as clean AI-ready prompts.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "deploy:pages": "bash scripts/deploy-pages.sh"
  },
